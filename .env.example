# ─────────────────────────────────────────────────────────────────────────────
# Yukti — Environment Configuration Template
# Copy this file to .env and fill in your values before starting.
#
#   cp .env.example .env
#
# Values below are calibrated for a ₹1000 INTRADAY live account with 5x DhanHQ
# margin. Scale ACCOUNT_VALUE, RISK_PCT, and related limits proportionally.
# ─────────────────────────────────────────────────────────────────────────────

# ── Operating Mode ────────────────────────────────────────────────────────────
# live     → real orders placed via DhanHQ (requires credentials below)
# paper    → real market data, simulated fills (safe to use for testing)
# shadow   → real data + real decisions, orders logged but NOT placed
# backtest → historical replay
MODE=live

# ── DhanHQ Credentials ────────────────────────────────────────────────────────
# Get these from your DhanHQ account → API section.
# Access tokens expire; regenerate and restart if you get 401 errors.
DHAN_CLIENT_ID=<your_dhan_client_id>
DHAN_ACCESS_TOKEN=<your_dhan_access_token>
DHAN_BASE_URL=https://api.dhan.co/v2

# Restart the container automatically after a token renewal cycle (requires docker socket access).
DHAN_AUTO_RESTART_ON_RENEW=false

# DhanHQ Sandbox (optional — for testing order flow without real money)
# DHAN_USE_SANDBOX=true
# DHAN_SANDBOX_CLIENT_ID=<sandbox_client_id>
# DHAN_SANDBOX_ACCESS_TOKEN=<sandbox_token>

# ── API Security ──────────────────────────────────────────────────────────────
# Required in live/shadow mode. Protects /control/* and WebSocket halt endpoints.
# Generate with: openssl rand -hex 32
CONTROL_API_KEY=<your_secret_control_key>

# ── Account & Leverage ────────────────────────────────────────────────────────
# ACCOUNT_VALUE    = actual cash in your DhanHQ account (₹)
# RISK_PCT         = fraction of account risked per trade (0.03 = 3%)
# INTRADAY_LEVERAGE= DhanHQ margin multiplier for INTRADAY equities (typically 5x)
#
# Exposure gates compare MARGIN (notional ÷ leverage) against ACCOUNT_VALUE.
# So a ₹2500 notional position at 5x only uses ₹500 margin = 50% of ₹1000 account.
#
# Rule: MAX_LOSS_CAP_PCT must be ≥ RISK_PCT × 1.5 (conviction-10 multiplier).
# Example: RISK_PCT=0.03 → MAX_LOSS_CAP_PCT ≥ 0.045 → set 0.05 for headroom.
#
# NOTE — ₹1000 account stock price ceiling:
# ATR-based sizing yields qty = floor(risk_rupees / stop_distance).
# With RISK_PCT=0.03 (₹30 risk) and ATR_MULTIPLIER=1.5:
#   ₹500  stock, 2% ATR → stop ≈ ₹15  → qty 2 ✓
#   ₹1000 stock, 2% ATR → stop ≈ ₹30  → qty 1 ✓
#   ₹1500 stock, 2% ATR → stop ≈ ₹45  → qty 0 ✗ (no trade placed — expected)
# The scanner will naturally gravitate toward lower-priced, high-liquidity names.
ACCOUNT_VALUE=1000
RISK_PCT=0.03
INTRADAY_LEVERAGE=5

# ── Risk Gates ────────────────────────────────────────────────────────────────
MAX_LOSS_CAP_PCT=0.05         # hard cap: max ₹ loss per trade as % of account (must be ≥ RISK_PCT × 1.5)
MAX_SINGLE_STOCK_PCT=0.50     # max margin in one position as % of account
MAX_SECTOR_PCT=0.40           # max margin in one sector as % of account
MAX_TOTAL_EXPOSURE_PCT=0.80   # max total margin across all open positions
MAX_OPEN_POSITIONS=3          # max concurrent open positions
MAX_TRADES_PER_DAY=3          # daily trade count cap — quality > quantity on a live test
DAILY_LOSS_LIMIT_PCT=0.05     # halt all trading if daily P&L drops below -5% (= -₹50 for ₹1000 account)

# Conviction: only trade setups you genuinely believe in.
# 7 = solid setup, clear structure, good risk/reward alignment.
# Dropping below 7 on live money leads to revenge trading and bad exits.
MIN_CONVICTION=7

# R:R: account for slippage (0.05–0.15% each way on NSE intraday).
# 1.8 stated R:R → ~1.6 effective after slippage. 2.0 gives real headroom.
MIN_RR=2.0

ATR_MULTIPLIER=1.5            # SL distance = ATR × this multiplier
MAX_ATR_MULTIPLIER=2.5        # reject setups with stop > ATR × this value
COOLDOWN_CYCLES=3             # scan cycles (×5 min) to wait before re-entering the same symbol

# ── AI Provider ───────────────────────────────────────────────────────────────
# gemini is free-tier friendly (15 RPM, 1500 RPD) — sufficient for ≤5 trades/day.
# claude is higher quality but costs ~$3/MTok input.
# ab_test runs both: primary executes real trades, secondary is logged for comparison.
AI_PROVIDER=gemini
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=<your_anthropic_key>   # only needed if AI_PROVIDER=claude or ab_test
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.1

# A/B test config — only used when AI_PROVIDER=ab_test
AB_PRIMARY=gemini
AB_SECONDARY=claude

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# Create a bot via @BotFather, then get your chat_id from @userinfobot.
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_CHAT_ID=<your_telegram_chat_id>

# ── Data Stores ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+psycopg://yukti:password@localhost:5432/yukti
REDIS_URL=redis://redis:6379/0

# ── Voyage AI (vector memory) ─────────────────────────────────────────────────
# Enables RAG retrieval of similar past trades for Arjun's context.
# No past data yet on day 1 — but set it up now so memory accumulates from trade 1.
VOYAGE_API_KEY=<your_voyage_api_key>

# ── Candle & Scanner Settings ─────────────────────────────────────────────────
CANDLE_INTERVAL=5             # candle timeframe in minutes
CANDLE_HISTORY=100            # number of candles to fetch per cycle
SCANNER_PICK_COUNT=15         # symbols held in the candidate pool
MAX_SYMBOLS_PER_SCAN_CYCLE=5  # symbols evaluated per scan cycle
WATCHLIST=                    # comma-separated symbols to always prioritise (e.g. TATAMOTORS,SBIN)

# ── Scheduler Times (IST) ─────────────────────────────────────────────────────
MARKET_OPEN=09:15
MORNING_PREP=09:00
POSITION_RECON=09:05
EOD_SQUAREOFF=15:15           # force-close intraday positions 15 min before 15:30 market close
DAILY_JOURNAL=16:00
